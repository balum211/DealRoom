# Copy to .env. Everything works WITHOUT a key (offline agents); a key turns on the LLM agents.

# --- LLM (OpenAI-compatible). Nebius AI Studio is the course default ---
NEBIUS_API_KEY=
FS_LLM_BASE_URL=https://api.studio.nebius.com/v1/
FS_LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Or OpenAI (leave NEBIUS_API_KEY empty and remove FS_LLM_BASE_URL):
# OPENAI_API_KEY=
# FS_LLM_MODEL=gpt-4.1-mini

# Or a LOCAL model with Ollama (Week 5): no data leaves your machine and no per-call fee.
#   ollama pull llama3.1:8b   then:
# OPENAI_API_KEY=ollama
# FS_LLM_BASE_URL=http://localhost:11434/v1
# FS_LLM_MODEL=llama3.1:8b
# DR_PRICE_IN_PER_M=0
# DR_PRICE_OUT_PER_M=0

# --- Observability (Week 4): LangSmith traces every agent, LLM call and tool call ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=dealroom

# --- Cost estimate: USD per 1M tokens for your provider (defaults are placeholders, set real rates) ---
# DR_PRICE_IN_PER_M=0.13
# DR_PRICE_OUT_PER_M=0.40

# --- DealRoom ---
# DR_AGENT_MODE=auto            # auto | offline
# DR_RESEARCH_VIA_MCP=0         # 1 = Researcher calls the knowledge base through the MCP server
# DR_MAX_VERIFY_RETRIES=2
# DR_CLAIMS_PER_SIDE=4
# DR_CANDIDATES_K=12
# DR_RESEARCH_RETRY_MIN_SCORE=0.5  # Researcher re-searches sub-questions whose best hit scores below this
