# Copy to .env (optional). DealRoom needs NO API key: the Writer drafts the memo with GPT-OSS 20B
# (open weights) through a free endpoint, and every other agent runs offline.

# --- Answer model (no key) ---
# FS_LLM=off                                   # never call the model; every agent runs offline
# FS_LLM_URL=https://text.pollinations.ai/openai  # any OpenAI-compatible endpoint that needs no key
# FS_LLM_MODEL=openai                          # Pollinations alias for GPT-OSS 20B
# DR_LLM_AGENTS=writer                         # writer (default) or all; the free tier allows one reply every 45 s

# --- Or a LOCAL open-weights model with Ollama (Week 5): no data leaves your machine ---
#   ollama pull llama3.1:8b   then:
# FS_LLM_URL=http://localhost:11434/v1/chat/completions
# FS_LLM_MODEL=llama3.1:8b
# DR_LLM_AGENTS=all

# --- DealRoom ---
# DR_AGENT_MODE=auto            # auto | offline
# DR_RESEARCH_VIA_MCP=0         # 1 = Researcher calls the knowledge base through the MCP server
# DR_MAX_VERIFY_RETRIES=2
# DR_CLAIMS_PER_SIDE=4
# DR_CANDIDATES_K=12
# DR_RESEARCH_RETRY_MIN_SCORE=0.5  # Researcher re-searches sub-questions whose best hit scores below this
